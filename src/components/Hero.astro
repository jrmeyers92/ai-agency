---
// Hero.astro - Clean, professional, unique design
---

<section class="relative bg-white pt-32 pb-20 lg:pt-40 lg:pb-32 overflow-hidden">
  <!-- Subtle grid background -->
  <div
    class="absolute inset-0 opacity-[0.03]"
    style="background-image: linear-gradient(#94a3b8 1px, transparent 1px), linear-gradient(90deg, #94a3b8 1px, transparent 1px); background-size: 32px 32px;"
  ></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl">
      <!-- Main headline -->
      <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-neutral-900 leading-[1.1] tracking-tight mb-8">
        I build web applications
        <span class="block mt-2 text-neutral-600">that solve problems.</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-xl sm:text-2xl text-neutral-600 leading-relaxed max-w-2xl mb-12">
        Full-stack developer based in St. Louis. I work with businesses to create custom web solutions—from simple sites to complex applications with AI integration.
      </p>

      <!-- CTA -->
      <div class="flex flex-col sm:flex-row gap-4 mb-20">
        <a
          href="#contact"
          class="inline-flex items-center justify-center px-8 py-4 bg-neutral-900 text-white font-medium rounded-lg hover:bg-neutral-800 transition-colors duration-200"
        >
          Start a project
        </a>
        <a
          href="#portfolio"
          class="inline-flex items-center justify-center px-8 py-4 border-2 border-neutral-300 text-neutral-900 font-medium rounded-lg hover:border-neutral-400 transition-colors duration-200"
        >
          View my work
        </a>
      </div>

      <!-- Capabilities grid -->
      <div class="border-t border-neutral-200 pt-12">
        <p class="text-sm font-medium text-neutral-500 uppercase tracking-wider mb-8">What I do</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          <div>
            <h3 class="font-semibold text-neutral-900 mb-2">Web Development</h3>
            <p class="text-neutral-600 text-sm leading-relaxed">
              Full-stack applications with React, Next.js, Node.js, and modern databases
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-neutral-900 mb-2">AI Integration</h3>
            <p class="text-neutral-600 text-sm leading-relaxed">
              RAG systems, chatbots, and intelligent automation with OpenAI and Anthropic
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-neutral-900 mb-2">Custom Solutions</h3>
            <p class="text-neutral-600 text-sm leading-relaxed">
              Business tools, dashboards, APIs, and integrations tailored to your needs
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Subtle accent element -->
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-neutral-100 rounded-full -z-10 translate-x-1/2 translate-y-1/2"></div>
</section>
