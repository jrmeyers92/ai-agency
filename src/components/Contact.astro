---
import { Icon } from "astro-icon/components";
---

<section
  class="relative py-24 lg:py-32 bg-gradient-to-b from-white to-neutral-50 overflow-hidden"
  id="contact"
>
  <!-- Decorative background -->
  <div
    class="absolute top-0 left-0 w-[500px] h-[500px] bg-gradient-to-br from-amber-100/40 to-orange-100/30 rounded-full blur-3xl opacity-50"
  >
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <p
        class="text-sm font-semibold text-amber-600 uppercase tracking-wider mb-3"
      >
        Contact
      </p>
      <h2
        class="text-4xl sm:text-5xl font-bold text-neutral-900 leading-tight mb-6"
      >
        Let's build something great
      </h2>
      <p class="text-xl text-neutral-600 leading-relaxed">
        Ready to start your project? Get in touch and let's discuss how I can
        help bring your ideas to life.
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-8 lg:gap-12">
      <!-- Left column: Contact info & process -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Contact Cards -->
        <div class="space-y-4">
          <a
            href="mailto:JakeRMeyers92@gmail.com"
            class="group block bg-white rounded-xl p-6 border border-neutral-200 hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
          >
            <div class="flex items-start gap-4">
              <div
                class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-lg flex items-center justify-center shadow-md"
              >
                <Icon name="mail" class="w-6 h-6 text-white" />
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-neutral-900 mb-1">Email</h3>
                <p
                  class="text-neutral-600 text-sm break-all group-hover:text-blue-600 transition-colors"
                >
                  JakeRMeyers92@gmail.com
                </p>
              </div>
            </div>
          </a>

          <a
            href="tel:+14174031570"
            class="group block bg-white rounded-xl p-6 border border-neutral-200 hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
          >
            <div class="flex items-start gap-4">
              <div
                class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-lg flex items-center justify-center shadow-md"
              >
                <Icon name="phone" class="w-6 h-6 text-white" />
              </div>
              <div>
                <h3 class="font-semibold text-neutral-900 mb-1">Phone</h3>
                <p
                  class="text-neutral-600 text-sm group-hover:text-emerald-600 transition-colors"
                >
                  (417) 403-1570
                </p>
              </div>
            </div>
          </a>

          <div class="bg-white rounded-xl p-6 border border-neutral-200">
            <div class="flex items-start gap-4">
              <div
                class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-600 rounded-lg flex items-center justify-center shadow-md"
              >
                <Icon name="map-pin" class="w-6 h-6 text-white" />
              </div>
              <div>
                <h3 class="font-semibold text-neutral-900 mb-1">Location</h3>
                <p class="text-neutral-600 text-sm">St. Louis, Missouri</p>
                <p class="text-neutral-500 text-xs mt-1">
                  Working with clients worldwide
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Response time card -->
        <div
          class="bg-gradient-to-br from-neutral-900 to-neutral-800 rounded-xl p-6 text-white"
        >
          <div class="flex items-start gap-3 mb-3">
            <svg
              class="w-6 h-6 text-amber-400 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <div>
              <h3 class="font-bold text-lg mb-1">Quick Response Time</h3>
              <p class="text-neutral-300 text-sm">
                I typically respond within 24 hours on weekdays. Let's get the
                conversation started!
              </p>
            </div>
          </div>
        </div>

        <!-- What to expect -->
        <div class="bg-white rounded-xl p-6 border border-neutral-200">
          <h3 class="font-bold text-neutral-900 mb-4 flex items-center gap-2">
            <svg
              class="w-5 h-5 text-amber-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                clip-rule="evenodd"></path>
            </svg>
            What happens next?
          </h3>
          <div class="space-y-3 text-sm text-neutral-600">
            <div class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>I'll review your message and respond within 24 hours</span>
            </div>
            <div class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>We'll schedule a quick call to discuss your needs</span>
            </div>
            <div class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span
                >You'll get a detailed proposal with transparent pricing</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Right column: Contact form -->
      <div class="lg:col-span-3">
        <div
          class="bg-white rounded-2xl p-8 border border-neutral-200 shadow-xl"
        >
          <h3 class="text-2xl font-bold text-neutral-900 mb-6">
            Send me a message
          </h3>

          <form
            name="contact"
            class="space-y-6"
            method="POST"
            data-netlify="true"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden">
              <label>
                Don't fill this out if you're human: <input name="bot-field" />
              </label>
            </p>

            <div class="grid sm:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label
                  for="name"
                  class="text-sm font-semibold text-neutral-900"
                >
                  Name <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  name="name"
                  id="name"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none"
                  placeholder="John Doe"
                />
              </div>

              <div class="space-y-2">
                <label
                  for="email"
                  class="text-sm font-semibold text-neutral-900"
                >
                  Email <span class="text-red-500">*</span>
                </label>
                <input
                  type="email"
                  name="email"
                  id="email"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none"
                  placeholder="john@example.com"
                />
              </div>
            </div>

            <div class="space-y-2">
              <label for="phone" class="text-sm font-semibold text-neutral-900">
                Phone <span class="text-neutral-400 text-xs font-normal"
                  >(Optional)</span
                >
              </label>
              <input
                type="tel"
                name="phone"
                id="phone"
                class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none"
                placeholder="(555) 123-4567"
              />
            </div>

            <div class="space-y-2">
              <label
                for="project-type"
                class="text-sm font-semibold text-neutral-900"
              >
                What are you looking for?
              </label>
              <select
                name="project-type"
                id="project-type"
                class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none"
              >
                <option value="">Select a service</option>
                <option value="website">Business Website</option>
                <option value="webapp">Full-Stack Application</option>
                <option value="ecommerce">E-Commerce Store</option>
                <option value="ai">AI Integration</option>
                <option value="retainer">Monthly Retainer</option>
                <option value="maintenance">Site Maintenance</option>
                <option value="other">Something Else</option>
              </select>
            </div>

            <div class="space-y-2">
              <label
                for="message"
                class="text-sm font-semibold text-neutral-900"
              >
                Tell me about your project <span class="text-red-500">*</span>
              </label>
              <textarea
                name="message"
                id="message"
                required
                rows="5"
                class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all resize-none outline-none"
                placeholder="Share your ideas, goals, timeline, or any questions you have..."
              ></textarea>
            </div>

            <div>
              <button
                type="submit"
                class="w-full inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-600 to-orange-600 text-white font-semibold rounded-xl hover:shadow-xl hover:shadow-orange-600/20 transition-all duration-300 hover:-translate-y-0.5"
              >
                Send Message
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </button>
            </div>

            <p class="text-xs text-neutral-500 text-center">
              By submitting this form, you agree to be contacted about your
              project inquiry.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
