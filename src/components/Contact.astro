---
import { Icon } from "astro-icon/components";
---

<section class="py-24 lg:py-32 bg-neutral-50" id="contact">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="mb-16">
      <p class="text-sm font-medium text-neutral-500 uppercase tracking-wider mb-4">Contact</p>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-neutral-900 mb-6">
        Let's work together
      </h2>
      <p class="text-xl text-neutral-600 leading-relaxed">
        Have a project in mind? Get in touch and let's discuss how I can help.
      </p>
    </div>

    <!-- Contact Cards -->
    <div class="grid sm:grid-cols-3 gap-6 mb-16">
      <div class="bg-white rounded-lg p-6 border border-neutral-200">
        <div class="w-10 h-10 rounded bg-neutral-100 flex items-center justify-center mb-3">
          <Icon name="mail" class="w-5 h-5 text-neutral-900" />
        </div>
        <h3 class="font-semibold text-neutral-900 mb-1">Email</h3>
        <p class="text-neutral-600 text-sm break-all">JakeRMeyers92@gmail.com</p>
      </div>

      <div class="bg-white rounded-lg p-6 border border-neutral-200">
        <div class="w-10 h-10 rounded bg-neutral-100 flex items-center justify-center mb-3">
          <Icon name="phone" class="w-5 h-5 text-neutral-900" />
        </div>
        <h3 class="font-semibold text-neutral-900 mb-1">Phone</h3>
        <p class="text-neutral-600 text-sm">(417) 403-1570</p>
      </div>

      <div class="bg-white rounded-lg p-6 border border-neutral-200">
        <div class="w-10 h-10 rounded bg-neutral-100 flex items-center justify-center mb-3">
          <Icon name="map-pin" class="w-5 h-5 text-neutral-900" />
        </div>
        <h3 class="font-semibold text-neutral-900 mb-1">Location</h3>
        <p class="text-neutral-600 text-sm">St. Louis, MO</p>
      </div>
    </div>

    <!-- Process Info -->
    <div class="bg-white rounded-lg p-8 border border-neutral-200 mb-12">
      <h3 class="font-semibold text-lg text-neutral-900 mb-6">How it works</h3>
      <div class="grid sm:grid-cols-3 gap-8">
        <div>
          <div class="flex items-center mb-3">
            <span class="w-8 h-8 bg-neutral-900 text-white rounded flex items-center justify-center text-sm font-bold mr-3">1</span>
            <h4 class="font-semibold text-neutral-900">Discovery</h4>
          </div>
          <p class="text-neutral-600 text-sm">We discuss your project requirements and goals</p>
        </div>
        <div>
          <div class="flex items-center mb-3">
            <span class="w-8 h-8 bg-neutral-900 text-white rounded flex items-center justify-center text-sm font-bold mr-3">2</span>
            <h4 class="font-semibold text-neutral-900">Proposal</h4>
          </div>
          <p class="text-neutral-600 text-sm">Clear timeline, scope, and transparent pricing</p>
        </div>
        <div>
          <div class="flex items-center mb-3">
            <span class="w-8 h-8 bg-neutral-900 text-white rounded flex items-center justify-center text-sm font-bold mr-3">3</span>
            <h4 class="font-semibold text-neutral-900">Development</h4>
          </div>
          <p class="text-neutral-600 text-sm">Regular updates and direct communication</p>
        </div>
      </div>
    </div>

    <!-- Contact Form -->
    <div class="bg-white rounded-lg p-8 border border-neutral-200">
      <form
        name="contact"
        class="space-y-6"
        method="POST"
        data-netlify="true"
      >
        <p class="hidden">
          <label>
            Don't fill this out if you're human: <input name="bot-field" />
          </label>
        </p>

        <div class="grid sm:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="name" class="text-sm font-medium text-neutral-900">
              Name
            </label>
            <input
              type="text"
              name="name"
              id="name"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-neutral-900 focus:border-neutral-900 transition-all"
              placeholder="John Doe"
            />
          </div>

          <div class="space-y-2">
            <label for="phone" class="text-sm font-medium text-neutral-900">
              Phone
            </label>
            <input
              type="tel"
              name="phone"
              id="phone"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-neutral-900 focus:border-neutral-900 transition-all"
              placeholder="(555) 123-4567"
            />
          </div>
        </div>

        <div class="space-y-2">
          <label for="email" class="text-sm font-medium text-neutral-900">
            Email
          </label>
          <input
            type="email"
            name="email"
            id="email"
            required
            class="w-full px-4 py-2.5 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-neutral-900 focus:border-neutral-900 transition-all"
            placeholder="john@example.com"
          />
        </div>

        <div class="space-y-2">
          <label for="message" class="text-sm font-medium text-neutral-900">
            Message
          </label>
          <textarea
            name="message"
            id="message"
            required
            rows="4"
            class="w-full px-4 py-2.5 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-neutral-900 focus:border-neutral-900 transition-all resize-none"
            placeholder="Tell me about your project..."></textarea>
        </div>

        <div>
          <button
            type="submit"
            class="w-full sm:w-auto px-8 py-4 bg-neutral-900 text-white font-medium rounded-lg hover:bg-neutral-800 transition-colors duration-200"
          >
            Send message
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
