---
// FAQ.astro - Clean, professional FAQ section
---

<section class="py-24 lg:py-32 bg-neutral-50" id="faq">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="mb-16">
      <p class="text-sm font-medium text-neutral-500 uppercase tracking-wider mb-4">FAQ</p>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-neutral-900 mb-6">
        Common questions
      </h2>
      <p class="text-xl text-neutral-600 leading-relaxed">
        Everything you need to know about working with me. Can't find your answer? Feel free to reach out.
      </p>
    </div>

    <!-- FAQ Items -->
    <div class="space-y-3">
      <!-- FAQ 1 -->
      <div class="bg-white rounded-lg border border-neutral-200 overflow-hidden">
        <button
          class="w-full px-6 py-5 text-left focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:ring-inset faq-button"
        >
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-lg font-semibold text-neutral-900">
              How much does a website or web application cost?
            </h3>
            <div class="flex-shrink-0">
              <svg
                class="w-5 h-5 text-neutral-600 transform transition-transform duration-200 faq-arrow"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>
        </button>
        <div class="hidden px-6 pb-5 faq-content">
          <p class="text-neutral-600 leading-relaxed">
            Project costs vary based on complexity and requirements. Business
            websites typically start at $1,500, while full-stack applications
            start around $4,000. I provide detailed, fixed-price quotes after
            our initial consultation where we discuss your specific needs,
            features, and timeline.
          </p>
        </div>
      </div>

      <!-- FAQ 2 -->
      <div class="bg-white rounded-lg border border-neutral-200 overflow-hidden">
        <button
          class="w-full px-6 py-5 text-left focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:ring-inset faq-button"
        >
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-lg font-semibold text-neutral-900">
              How long does it take to build a website or application?
            </h3>
            <div class="flex-shrink-0">
              <svg
                class="w-5 h-5 text-neutral-600 transform transition-transform duration-200 faq-arrow"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>
        </button>
        <div class="hidden px-6 pb-5 faq-content">
          <p class="text-neutral-600 leading-relaxed">
            Timeline depends on project scope. A standard business website
            typically takes 2-3 weeks, while full-stack applications can take
            6-10 weeks. I'll provide a detailed timeline during our discovery
            phase and keep you updated throughout development with regular
            progress updates.
          </p>
        </div>
      </div>

      <!-- FAQ 3 -->
      <div class="bg-white rounded-lg border border-neutral-200 overflow-hidden">
        <button
          class="w-full px-6 py-5 text-left focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:ring-inset faq-button"
        >
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-lg font-semibold text-neutral-900">
              Do you offer ongoing support and maintenance?
            </h3>
            <div class="flex-shrink-0">
              <svg
                class="w-5 h-5 text-neutral-600 transform transition-transform duration-200 faq-arrow"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>
        </button>
        <div class="hidden px-6 pb-5 faq-content">
          <p class="text-neutral-600 leading-relaxed">
            Yes! All projects include a 30-day bug fix warranty after launch.
            For ongoing support, I offer monthly maintenance packages that
            include updates, security patches, content changes, and priority
            support. We can discuss the best support plan for your needs.
          </p>
        </div>
      </div>

      <!-- FAQ 4 -->
      <div class="bg-white rounded-lg border border-neutral-200 overflow-hidden">
        <button
          class="w-full px-6 py-5 text-left focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:ring-inset faq-button"
        >
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-lg font-semibold text-neutral-900">
              Can you integrate AI features into my website or app?
            </h3>
            <div class="flex-shrink-0">
              <svg
                class="w-5 h-5 text-neutral-600 transform transition-transform duration-200 faq-arrow"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>
        </button>
        <div class="hidden px-6 pb-5 faq-content">
          <p class="text-neutral-600 leading-relaxed">
            Absolutely! I can add AI capabilities like chatbots, intelligent
            search, content generation, or custom automation to any project.
            We'll discuss whether AI makes sense for your use case and implement
            solutions that provide real value to your users without unnecessary
            complexity.
          </p>
        </div>
      </div>

      <!-- FAQ 5 -->
      <div class="bg-white rounded-lg border border-neutral-200 overflow-hidden">
        <button
          class="w-full px-6 py-5 text-left focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:ring-inset faq-button"
        >
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-lg font-semibold text-neutral-900">
              Do you work with clients remotely?
            </h3>
            <div class="flex-shrink-0">
              <svg
                class="w-5 h-5 text-neutral-600 transform transition-transform duration-200 faq-arrow"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>
        </button>
        <div class="hidden px-6 pb-5 faq-content">
          <p class="text-neutral-600 leading-relaxed">
            Yes! While I'm based in St. Louis, Missouri, I work with clients
            anywhere. I've successfully completed projects for businesses across
            the US and internationally. We'll communicate via video calls,
            email, and project management tools to ensure smooth collaboration
            regardless of location.
          </p>
        </div>
      </div>

      <!-- FAQ 6 -->
      <div class="bg-white rounded-lg border border-neutral-200 overflow-hidden">
        <button
          class="w-full px-6 py-5 text-left focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:ring-inset faq-button"
        >
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-lg font-semibold text-neutral-900">
              What technologies and tools do you use?
            </h3>
            <div class="flex-shrink-0">
              <svg
                class="w-5 h-5 text-neutral-600 transform transition-transform duration-200 faq-arrow"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>
        </button>
        <div class="hidden px-6 pb-5 faq-content">
          <p class="text-neutral-600 leading-relaxed mb-3">
            I use modern, reliable technologies that ensure your project is
            fast, secure, and maintainable:
          </p>
          <ul class="text-neutral-600 leading-relaxed space-y-2">
            <li><strong>Frontend:</strong> React, Next.js, Astro, Tailwind CSS</li>
            <li><strong>Backend:</strong> Node.js, Python (FastAPI), Java</li>
            <li><strong>Databases:</strong> PostgreSQL, MongoDB</li>
            <li><strong>Deployment:</strong> Vercel, AWS, Netlify</li>
          </ul>
        </div>
      </div>

      <!-- FAQ 7 -->
      <div class="bg-white rounded-lg border border-neutral-200 overflow-hidden">
        <button
          class="w-full px-6 py-5 text-left focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:ring-inset faq-button"
        >
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-lg font-semibold text-neutral-900">
              What's your process for starting a new project?
            </h3>
            <div class="flex-shrink-0">
              <svg
                class="w-5 h-5 text-neutral-600 transform transition-transform duration-200 faq-arrow"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>
        </button>
        <div class="hidden px-6 pb-5 faq-content">
          <p class="text-neutral-600 leading-relaxed mb-3">
            My process is straightforward and collaborative:
          </p>
          <ol class="text-neutral-600 leading-relaxed space-y-2 list-decimal pl-5">
            <li>
              <strong>Discovery Call:</strong> We discuss your goals, requirements,
              and timeline
            </li>
            <li>
              <strong>Proposal:</strong> I provide a detailed quote with project
              scope and milestones
            </li>
            <li>
              <strong>Agreement:</strong> Once approved, we sign a contract and schedule
              kickoff
            </li>
            <li>
              <strong>Development:</strong> Regular updates and check-ins throughout
              the build
            </li>
            <li>
              <strong>Review & Launch:</strong> Testing, refinements, and deployment
            </li>
            <li>
              <strong>Support:</strong> Post-launch support and training as needed
            </li>
          </ol>
        </div>
      </div>
    </div>

    <!-- Still have questions CTA -->
    <div class="mt-16 bg-white rounded-lg p-8 border border-neutral-200">
      <h3 class="text-2xl font-bold text-neutral-900 mb-3">
        Still have questions?
      </h3>
      <p class="text-neutral-600 mb-6">
        Don't see your question answered here? I'm happy to discuss your
        specific needs and provide personalized answers.
      </p>
      <a
        href="#contact"
        class="inline-flex items-center justify-center px-8 py-4 bg-neutral-900 text-white font-medium rounded-lg hover:bg-neutral-800 transition-colors duration-200"
      >
        Get in touch
      </a>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const faqButtons = document.querySelectorAll(".faq-button");

    faqButtons.forEach((button) => {
      button.addEventListener("click", function () {
        const content = this.nextElementSibling as HTMLElement;
        const arrow = this.querySelector(".faq-arrow") as HTMLElement;
        const isHidden = content.classList.contains("hidden");

        // Close all other FAQs
        document.querySelectorAll(".faq-content").forEach((otherContent) => {
          if (
            otherContent !== content &&
            !otherContent.classList.contains("hidden")
          ) {
            otherContent.classList.add("hidden");
            const otherArrow =
              otherContent.previousElementSibling?.querySelector(
                ".faq-arrow",
              ) as HTMLElement;
            if (otherArrow) {
              otherArrow.style.transform = "rotate(0deg)";
            }
          }
        });

        // Toggle current FAQ
        if (isHidden) {
          content.classList.remove("hidden");
          arrow.style.transform = "rotate(180deg)";
        } else {
          content.classList.add("hidden");
          arrow.style.transform = "rotate(0deg)";
        }
      });
    });
  });
</script>
