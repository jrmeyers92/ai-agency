---
// Portfolio.astro - Redesigned to showcase projects with more impact
---

<section
  class="relative py-24 lg:py-32 bg-white overflow-hidden"
  id="portfolio"
>
  <!-- Decorative background -->
  <div
    class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-gradient-to-br from-purple-100/40 to-pink-100/30 rounded-full blur-3xl opacity-50"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="max-w-3xl mb-20">
      <p
        class="text-sm font-semibold text-amber-600 uppercase tracking-wider mb-3"
      >
        Portfolio
      </p>
      <h2
        class="text-4xl sm:text-5xl font-bold text-neutral-900 leading-tight mb-6"
      >
        Recent work
      </h2>
      <p class="text-xl text-neutral-600 leading-relaxed">
        Enterprise-grade applications built for real businesses. Every project
        showcases clean code, thoughtful architecture, and measurable results.
      </p>
    </div>

    <!-- Projects -->
    <div class="space-y-20">
      <!-- Project 1: Customer Portal -->
      <div class="group">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <!-- Image -->
          <div class="lg:col-span-7">
            <div class="relative">
              <div
                class="aspect-[16/10] bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl overflow-hidden shadow-2xl group-hover:shadow-3xl transition-shadow duration-300"
              >
                <div
                  class="w-full h-full flex items-center justify-center p-12"
                >
                  <!-- Dashboard mockup -->
                  <div
                    class="w-full h-full bg-white/10 backdrop-blur-sm rounded-lg p-8 border border-white/20"
                  >
                    <div class="flex items-center gap-3 mb-6">
                      <div class="w-3 h-3 rounded-full bg-white/40"></div>
                      <div class="w-3 h-3 rounded-full bg-white/40"></div>
                      <div class="w-3 h-3 rounded-full bg-white/40"></div>
                    </div>
                    <div class="space-y-3">
                      <div class="h-12 bg-white/20 rounded"></div>
                      <div class="grid grid-cols-3 gap-3">
                        <div class="h-20 bg-white/30 rounded"></div>
                        <div class="h-20 bg-white/30 rounded"></div>
                        <div class="h-20 bg-white/30 rounded"></div>
                      </div>
                      <div class="h-32 bg-white/20 rounded"></div>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Decorative element -->
              <div
                class="absolute -bottom-4 -right-4 w-24 h-24 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-xl opacity-20 -z-10"
              >
              </div>
            </div>
          </div>

          <!-- Content -->
          <div class="lg:col-span-5">
            <div
              class="inline-flex items-center gap-2 px-3 py-1 bg-blue-100 text-blue-700 text-xs font-semibold rounded-full mb-4"
            >
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"></path>
                <path
                  fill-rule="evenodd"
                  d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Full-Stack App
            </div>

            <h3 class="text-3xl font-bold text-neutral-900 mb-4">
              Customer Portal Dashboard
            </h3>

            <p class="text-lg text-neutral-600 leading-relaxed mb-6">
              Full-stack customer portal with real-time data visualization,
              account management, and integrated billing. Built to handle
              enterprise-scale traffic with 1,000+ active users daily.
            </p>

            <!-- Key features -->
            <div class="space-y-3 mb-6">
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-emerald-600 mt-0.5 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-neutral-700"
                  >Real-time analytics and reporting dashboards</span
                >
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-emerald-600 mt-0.5 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-neutral-700"
                  >Integrated payment processing and billing</span
                >
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-emerald-600 mt-0.5 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-neutral-700"
                  >Role-based access control and security</span
                >
              </div>
            </div>

            <!-- Tech stack -->
            <div class="flex flex-wrap gap-2">
              <span
                class="px-3 py-1.5 bg-neutral-100 text-neutral-700 text-sm font-medium rounded-lg"
                >React</span
              >
              <span
                class="px-3 py-1.5 bg-neutral-100 text-neutral-700 text-sm font-medium rounded-lg"
                >Node.js</span
              >
              <span
                class="px-3 py-1.5 bg-neutral-100 text-neutral-700 text-sm font-medium rounded-lg"
                >PostgreSQL</span
              >
              <span
                class="px-3 py-1.5 bg-neutral-100 text-neutral-700 text-sm font-medium rounded-lg"
                >AWS</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Project 2: AI Chatbot -->
      <div class="group">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <!-- Content (left on desktop) -->
          <div class="lg:col-span-5 lg:order-1">
            <div
              class="inline-flex items-center gap-2 px-3 py-1 bg-purple-100 text-purple-700 text-xs font-semibold rounded-full mb-4"
            >
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                <path
                  d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"
                ></path>
              </svg>
              AI Integration
            </div>

            <h3 class="text-3xl font-bold text-neutral-900 mb-4">
              Intelligent Customer Support Bot
            </h3>

            <p class="text-lg text-neutral-600 leading-relaxed mb-6">
              AI-powered chatbot trained on company documentation and FAQs.
              Handles 70% of customer inquiries automatically while learning
              from each interaction to improve responses.
            </p>

            <!-- Key features -->
            <div class="space-y-3 mb-6">
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-emerald-600 mt-0.5 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-neutral-700"
                  >RAG system with custom knowledge base</span
                >
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-emerald-600 mt-0.5 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-neutral-700"
                  >Seamless handoff to human agents</span
                >
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-emerald-600 mt-0.5 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-neutral-700"
                  >Analytics dashboard for insights</span
                >
              </div>
            </div>

            <!-- Tech stack -->
            <div class="flex flex-wrap gap-2">
              <span
                class="px-3 py-1.5 bg-neutral-100 text-neutral-700 text-sm font-medium rounded-lg"
                >OpenAI</span
              >
              <span
                class="px-3 py-1.5 bg-neutral-100 text-neutral-700 text-sm font-medium rounded-lg"
                >Python</span
              >
              <span
                class="px-3 py-1.5 bg-neutral-100 text-neutral-700 text-sm font-medium rounded-lg"
                >FastAPI</span
              >
              <span
                class="px-3 py-1.5 bg-neutral-100 text-neutral-700 text-sm font-medium rounded-lg"
                >Pinecone</span
              >
            </div>
          </div>

          <!-- Image (right on desktop) -->
          <div class="lg:col-span-7 lg:order-2">
            <div class="relative">
              <div
                class="aspect-[16/10] bg-gradient-to-br from-purple-500 to-pink-600 rounded-2xl overflow-hidden shadow-2xl group-hover:shadow-3xl transition-shadow duration-300"
              >
                <div
                  class="w-full h-full flex items-center justify-center p-12"
                >
                  <!-- Chat mockup -->
                  <div
                    class="w-full h-full bg-white/10 backdrop-blur-sm rounded-lg p-6 border border-white/20"
                  >
                    <div class="space-y-3">
                      <div class="flex justify-end">
                        <div
                          class="max-w-[70%] h-10 bg-white/30 rounded-2xl rounded-tr-sm"
                        >
                        </div>
                      </div>
                      <div class="flex justify-start">
                        <div
                          class="max-w-[80%] h-16 bg-white/40 rounded-2xl rounded-tl-sm"
                        >
                        </div>
                      </div>
                      <div class="flex justify-end">
                        <div
                          class="max-w-[60%] h-8 bg-white/30 rounded-2xl rounded-tr-sm"
                        >
                        </div>
                      </div>
                      <div class="flex justify-start">
                        <div
                          class="max-w-[85%] h-20 bg-white/40 rounded-2xl rounded-tl-sm"
                        >
                        </div>
                      </div>
                      <div class="flex justify-end">
                        <div
                          class="max-w-[50%] h-8 bg-white/30 rounded-2xl rounded-tr-sm"
                        >
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Decorative element -->
              <div
                class="absolute -bottom-4 -left-4 w-24 h-24 bg-gradient-to-br from-purple-500 to-pink-600 rounded-xl opacity-20 -z-10"
              >
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Project 3: Automation Suite -->
      <div class="group">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <!-- Image -->
          <div class="lg:col-span-7">
            <div class="relative">
              <div
                class="aspect-[16/10] bg-gradient-to-br from-emerald-500 to-teal-600 rounded-2xl overflow-hidden shadow-2xl group-hover:shadow-3xl transition-shadow duration-300"
              >
                <div
                  class="w-full h-full flex items-center justify-center p-12"
                >
                  <!-- Automation mockup -->
                  <div
                    class="w-full h-full bg-white/10 backdrop-blur-sm rounded-lg p-8 border border-white/20"
                  >
                    <div class="grid grid-cols-3 gap-4 mb-4">
                      <div class="h-16 bg-white/30 rounded-lg"></div>
                      <div class="h-16 bg-white/30 rounded-lg"></div>
                      <div class="h-16 bg-white/30 rounded-lg"></div>
                    </div>
                    <div class="space-y-2">
                      <div class="h-3 bg-white/20 rounded w-3/4"></div>
                      <div class="h-3 bg-white/20 rounded w-full"></div>
                      <div class="h-3 bg-white/20 rounded w-5/6"></div>
                    </div>
                    <div class="mt-6 h-24 bg-white/25 rounded"></div>
                  </div>
                </div>
              </div>
              <!-- Decorative element -->
              <div
                class="absolute -bottom-4 -right-4 w-24 h-24 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl opacity-20 -z-10"
              >
              </div>
            </div>
          </div>

          <!-- Content -->
          <div class="lg:col-span-5">
            <div
              class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-100 text-emerald-700 text-xs font-semibold rounded-full mb-4"
            >
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z"
                  clip-rule="evenodd"></path>
              </svg>
              Business Automation
            </div>

            <h3 class="text-3xl font-bold text-neutral-900 mb-4">
              Data Processing Pipeline
            </h3>

            <p class="text-lg text-neutral-600 leading-relaxed mb-6">
              Automated data processing and reporting system that reduced manual
              work by 80%. Handles ETL processes, generates reports, and sends
              alerts—all without human intervention.
            </p>

            <!-- Key features -->
            <div class="space-y-3 mb-6">
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-emerald-600 mt-0.5 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-neutral-700"
                  >Scheduled data extraction and transformation</span
                >
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-emerald-600 mt-0.5 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-neutral-700"
                  >Automated report generation and distribution</span
                >
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-emerald-600 mt-0.5 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-neutral-700"
                  >Error monitoring and alerting system</span
                >
              </div>
            </div>

            <!-- Tech stack -->
            <div class="flex flex-wrap gap-2">
              <span
                class="px-3 py-1.5 bg-neutral-100 text-neutral-700 text-sm font-medium rounded-lg"
                >Python</span
              >
              <span
                class="px-3 py-1.5 bg-neutral-100 text-neutral-700 text-sm font-medium rounded-lg"
                >FastAPI</span
              >
              <span
                class="px-3 py-1.5 bg-neutral-100 text-neutral-700 text-sm font-medium rounded-lg"
                >MongoDB</span
              >
              <span
                class="px-3 py-1.5 bg-neutral-100 text-neutral-700 text-sm font-medium rounded-lg"
                >Redis</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom CTA -->
    <div
      class="mt-24 bg-gradient-to-br from-neutral-900 to-neutral-800 rounded-2xl p-10 md:p-12"
    >
      <div class="max-w-3xl">
        <h3 class="text-3xl md:text-4xl font-bold text-white mb-4">
          Your project could be next
        </h3>
        <p class="text-xl text-neutral-300 leading-relaxed mb-8">
          Every project gets the same level of attention to detail, clean
          architecture, and professional execution. Let's build something great
          together.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-600 to-orange-600 text-white font-semibold rounded-xl hover:shadow-xl hover:shadow-orange-600/20 transition-all duration-300 hover:-translate-y-0.5"
          >
            Start your project
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a
            href="/services"
            class="inline-flex items-center justify-center px-8 py-4 bg-white/10 backdrop-blur-sm border border-white/20 text-white font-semibold rounded-xl hover:bg-white/20 transition-all duration-200"
          >
            View all services
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
