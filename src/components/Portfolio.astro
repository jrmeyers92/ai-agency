---
// Portfolio.astro - Clean, professional project showcase
---

<section class="py-24 lg:py-32 bg-white" id="portfolio">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="max-w-3xl mb-20">
      <p class="text-sm font-medium text-neutral-500 uppercase tracking-wider mb-4">Work</p>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-neutral-900 mb-6">
        Selected projects
      </h2>
      <p class="text-xl text-neutral-600 leading-relaxed">
        Professional projects demonstrating my capabilities across web development and AI integration.
      </p>
    </div>

    <!-- Projects grid -->
    <div class="space-y-16">
      <!-- Customer Portal Dashboard -->
      <div class="grid lg:grid-cols-5 gap-8 lg:gap-12 items-start">
        <div class="lg:col-span-2">
          <div class="aspect-[4/3] bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg overflow-hidden">
            <div class="w-full h-full flex items-center justify-center">
              <div class="w-16 h-16 text-blue-600">
                <svg fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"></path>
                </svg>
              </div>
            </div>
          </div>
        </div>
        <div class="lg:col-span-3">
          <div class="mb-4">
            <h3 class="text-2xl font-bold text-neutral-900 mb-2">Customer Portal Dashboard</h3>
            <p class="text-neutral-600">
              Full-stack customer portal with real-time data visualization, account management, and integrated billing system built for enterprise use.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-neutral-100 text-neutral-700 text-xs font-medium rounded">React</span>
            <span class="px-3 py-1 bg-neutral-100 text-neutral-700 text-xs font-medium rounded">Node.js</span>
            <span class="px-3 py-1 bg-neutral-100 text-neutral-700 text-xs font-medium rounded">PostgreSQL</span>
            <span class="px-3 py-1 bg-neutral-100 text-neutral-700 text-xs font-medium rounded">AWS</span>
          </div>
          <div class="flex items-center gap-4 text-sm">
            <span class="text-neutral-600">1,000+ active users</span>
            <span class="text-neutral-400">•</span>
            <span class="text-neutral-600">Enterprise</span>
          </div>
        </div>
      </div>

      <!-- Automation & Analytics Suite -->
      <div class="grid lg:grid-cols-5 gap-8 lg:gap-12 items-start">
        <div class="lg:col-span-2 lg:order-2">
          <div class="aspect-[4/3] bg-gradient-to-br from-green-50 to-emerald-100 rounded-lg overflow-hidden">
            <div class="w-full h-full flex items-center justify-center">
              <div class="w-16 h-16 text-green-600">
                <svg fill="currentColor" viewBox="0 0 24 24">
                  <path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"></path>
                </svg>
              </div>
            </div>
          </div>
        </div>
        <div class="lg:col-span-3 lg:order-1">
          <div class="mb-4">
            <h3 class="text-2xl font-bold text-neutral-900 mb-2">Automation & Analytics Suite</h3>
            <p class="text-neutral-600">
              Internal toolset for data processing automation, reporting dashboards, and workflow optimization. Reduced manual data entry by 80%.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-neutral-100 text-neutral-700 text-xs font-medium rounded">Python</span>
            <span class="px-3 py-1 bg-neutral-100 text-neutral-700 text-xs font-medium rounded">FastAPI</span>
            <span class="px-3 py-1 bg-neutral-100 text-neutral-700 text-xs font-medium rounded">React</span>
            <span class="px-3 py-1 bg-neutral-100 text-neutral-700 text-xs font-medium rounded">MongoDB</span>
          </div>
          <div class="flex items-center gap-4 text-sm">
            <span class="text-neutral-600">80% time saved</span>
            <span class="text-neutral-400">•</span>
            <span class="text-neutral-600">Business Tools</span>
          </div>
        </div>
      </div>

      <!-- Multi-Platform Integration -->
      <div class="grid lg:grid-cols-5 gap-8 lg:gap-12 items-start">
        <div class="lg:col-span-2">
          <div class="aspect-[4/3] bg-gradient-to-br from-purple-50 to-pink-100 rounded-lg overflow-hidden">
            <div class="w-full h-full flex items-center justify-center">
              <div class="w-16 h-16 text-purple-600">
                <svg fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 3H5c-1.1 0-1.99.9-1.99 2L3 19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"></path>
                </svg>
              </div>
            </div>
          </div>
        </div>
        <div class="lg:col-span-3">
          <div class="mb-4">
            <h3 class="text-2xl font-bold text-neutral-900 mb-2">Multi-Platform Integration</h3>
            <p class="text-neutral-600">
              Custom API middleware connecting multiple third-party services with automated data synchronization and error handling for seamless operations.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-neutral-100 text-neutral-700 text-xs font-medium rounded">Node.js</span>
            <span class="px-3 py-1 bg-neutral-100 text-neutral-700 text-xs font-medium rounded">Express</span>
            <span class="px-3 py-1 bg-neutral-100 text-neutral-700 text-xs font-medium rounded">REST APIs</span>
            <span class="px-3 py-1 bg-neutral-100 text-neutral-700 text-xs font-medium rounded">Redis</span>
          </div>
          <div class="flex items-center gap-4 text-sm">
            <span class="text-neutral-600">99.9% uptime</span>
            <span class="text-neutral-400">•</span>
            <span class="text-neutral-600">Integration</span>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-24 pt-16 border-t border-neutral-200">
      <div class="max-w-3xl">
        <h3 class="text-3xl font-bold text-neutral-900 mb-4">Ready to start your project?</h3>
        <p class="text-xl text-neutral-600 mb-8">
          I bring professional-grade development experience to every project, ensuring quality and reliability from start to finish.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="#contact"
            class="inline-flex items-center justify-center px-8 py-4 bg-neutral-900 text-white font-medium rounded-lg hover:bg-neutral-800 transition-colors duration-200"
          >
            Get in touch
          </a>
          <a
            href="#services"
            class="inline-flex items-center justify-center px-8 py-4 border-2 border-neutral-300 text-neutral-900 font-medium rounded-lg hover:border-neutral-400 transition-colors duration-200"
          >
            View services
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
