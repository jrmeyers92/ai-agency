---
import { Icon } from "astro-icon/components";

const navItems = [
  { label: "About", href: "#about" },
  { label: "Services", href: "#services" },
  { label: "Work", href: "#portfolio" },
  { label: "Contact", href: "#contact" },
];
---

<header
  class="fixed w-full top-0 z-50 bg-white/80 backdrop-blur-md border-b border-neutral-200/50"
  id="navbar"
>
  <nav
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16"
    aria-label="Main navigation"
  >
    <div class="flex justify-between items-center h-full">
      <!-- Logo -->
      <a href="/" class="relative z-10 font-display font-bold text-xl text-neutral-900" aria-label="Home">
        Jake Meyers
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        <ul class="flex items-center gap-8">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm font-medium text-neutral-600 hover:text-neutral-900 transition-colors duration-200"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="md:hidden relative z-50 p-2"
        aria-label="Toggle menu"
        aria-expanded="false"
        id="menu-toggle"
      >
        <div class="w-5 h-4 flex flex-col justify-between">
          <span class="w-full h-0.5 bg-neutral-900 transform transition-all duration-300"></span>
          <span class="w-full h-0.5 bg-neutral-900 transform transition-all duration-300"></span>
          <span class="w-full h-0.5 bg-neutral-900 transform transition-all duration-300"></span>
        </div>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden fixed inset-0 z-40 invisible opacity-0 transition-all duration-300"
    aria-hidden="true"
  >
    <div class="absolute inset-0 bg-black/20 backdrop-blur-sm"></div>

    <div class="absolute inset-y-0 right-0 w-full max-w-sm bg-white shadow-2xl transform translate-x-full transition-transform duration-300">
      <div class="h-16"></div>

      <nav class="px-6 py-8">
        <ul class="space-y-1">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block py-3 text-lg font-medium text-neutral-900 hover:text-neutral-600 transition-colors duration-200"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  const navbar = document.getElementById("navbar");
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const backdrop = mobileMenu?.querySelector("div");
  const menuPanel = mobileMenu?.querySelector("div:last-child");

  function toggleMenu(show: boolean) {
    if (!mobileMenu || !backdrop || !menuPanel || !menuToggle) return;

    menuToggle.setAttribute("aria-expanded", show.toString());
    mobileMenu.setAttribute("aria-hidden", (!show).toString());
    document.body.style.overflow = show ? "hidden" : "";

    const spans = menuToggle.querySelectorAll("span");

    if (show) {
      mobileMenu.classList.remove("invisible", "opacity-0");
      menuPanel.classList.remove("translate-x-full");
      spans[0].style.transform = "rotate(45deg) translateY(7px)";
      spans[1].style.opacity = "0";
      spans[2].style.transform = "rotate(-45deg) translateY(-7px)";
    } else {
      mobileMenu.classList.add("opacity-0");
      menuPanel.classList.add("translate-x-full");
      setTimeout(() => mobileMenu.classList.add("invisible"), 300);
      spans[0].style.transform = "";
      spans[1].style.opacity = "";
      spans[2].style.transform = "";
    }
  }

  menuToggle?.addEventListener("click", () => {
    const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
    toggleMenu(!isExpanded);
  });

  backdrop?.addEventListener("click", () => toggleMenu(false));

  const menuLinks = mobileMenu?.querySelectorAll("a");
  menuLinks?.forEach((link) => {
    link.addEventListener("click", () => toggleMenu(false));
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menuToggle?.getAttribute("aria-expanded") === "true") {
      toggleMenu(false);
    }
  });
</script>

<style>
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid #171717;
    outline-offset: 2px;
  }
</style>
