---
// Footer.astro - Redesigned with better visual hierarchy and CTA
---

<footer class="relative bg-neutral-900 text-white overflow-hidden">
  <!-- Decorative gradient -->
  <div
    class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-amber-500/50 to-transparent"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- CTA Section -->
    <div class="py-16 border-b border-neutral-800">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
          Ready to start your project?
        </h2>
        <p class="text-xl text-neutral-400 mb-8 leading-relaxed">
          Let's discuss how I can help bring your ideas to life with clean code
          and thoughtful design.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-600 to-orange-600 text-white font-semibold rounded-xl hover:shadow-xl hover:shadow-orange-600/20 transition-all duration-300 hover:-translate-y-0.5"
          >
            Get in touch
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a
            href="/work"
            class="inline-flex items-center justify-center px-8 py-4 bg-white/10 backdrop-blur-sm border border-white/20 text-white font-semibold rounded-xl hover:bg-white/20 transition-all duration-200"
          >
            View my work
          </a>
        </div>
      </div>
    </div>

    <!-- Main Footer Content -->
    <div class="py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12">
      <!-- Brand Column - Spans 4 columns on large screens -->
      <div class="lg:col-span-4">
        <div class="mb-6">
          <h3 class="text-2xl font-bold text-white mb-2">Jake Meyers</h3>
          <p class="text-amber-400 text-sm font-semibold">
            Full-Stack Web Developer
          </p>
        </div>
        <p class="text-neutral-400 text-sm leading-relaxed mb-6">
          Building modern web applications and AI-powered solutions for
          businesses that need quality work without agency prices.
        </p>

        <!-- Stats -->
        <div class="grid grid-cols-2 gap-4 mb-6">
          <div>
            <div class="text-2xl font-bold text-white">5+</div>
            <div class="text-xs text-neutral-400">Years Experience</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-white">24h</div>
            <div class="text-xs text-neutral-400">Response Time</div>
          </div>
        </div>

        <!-- Social Links -->
        <div class="flex gap-3">
          <a
            href="https://github.com/jrmeyers92"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="w-10 h-10 rounded-lg bg-neutral-800 hover:bg-gradient-to-br hover:from-amber-600 hover:to-orange-600 flex items-center justify-center transition-all duration-300 group"
          >
            <svg
              class="w-5 h-5 text-neutral-400 group-hover:text-white transition-colors"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </a>
          <a
            href="https://linkedin.com/in/jake-meyers-477b7a52"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="w-10 h-10 rounded-lg bg-neutral-800 hover:bg-gradient-to-br hover:from-amber-600 hover:to-orange-600 flex items-center justify-center transition-all duration-300 group"
          >
            <svg
              class="w-5 h-5 text-neutral-400 group-hover:text-white transition-colors"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
          <a
            href="mailto:JakeRMeyers92@gmail.com"
            aria-label="Email"
            class="w-10 h-10 rounded-lg bg-neutral-800 hover:bg-gradient-to-br hover:from-amber-600 hover:to-orange-600 flex items-center justify-center transition-all duration-300 group"
          >
            <svg
              class="w-5 h-5 text-neutral-400 group-hover:text-white transition-colors"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links - Spans 2 columns -->
      <div class="lg:col-span-2">
        <h4 class="text-white font-bold mb-4 text-sm uppercase tracking-wider">
          Navigation
        </h4>
        <ul class="space-y-3">
          <li>
            <a
              href="/about"
              class="text-neutral-400 hover:text-amber-400 transition-colors text-sm flex items-center gap-2 group"
            >
              <svg
                class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
              About
            </a>
          </li>
          <li>
            <a
              href="/services"
              class="text-neutral-400 hover:text-amber-400 transition-colors text-sm flex items-center gap-2 group"
            >
              <svg
                class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
              Services
            </a>
          </li>
          <li>
            <a
              href="/work"
              class="text-neutral-400 hover:text-amber-400 transition-colors text-sm flex items-center gap-2 group"
            >
              <svg
                class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
              Work
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class="text-neutral-400 hover:text-amber-400 transition-colors text-sm flex items-center gap-2 group"
            >
              <svg
                class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
              Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- Services - Spans 3 columns -->
      <div class="lg:col-span-3">
        <h4 class="text-white font-bold mb-4 text-sm uppercase tracking-wider">
          What I Do
        </h4>
        <ul class="space-y-3">
          <li class="flex items-start gap-2">
            <svg
              class="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-neutral-400 text-sm">Full-Stack Development</span>
          </li>
          <li class="flex items-start gap-2">
            <svg
              class="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-neutral-400 text-sm"
              >AI Integration & Chatbots</span
            >
          </li>
          <li class="flex items-start gap-2">
            <svg
              class="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-neutral-400 text-sm">E-Commerce Solutions</span>
          </li>
          <li class="flex items-start gap-2">
            <svg
              class="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-neutral-400 text-sm">Monthly Retainers</span>
          </li>
          <li class="flex items-start gap-2">
            <svg
              class="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-neutral-400 text-sm">Custom Business Tools</span>
          </li>
        </ul>
      </div>

      <!-- Contact Info - Spans 3 columns -->
      <div class="lg:col-span-3">
        <h4 class="text-white font-bold mb-4 text-sm uppercase tracking-wider">
          Get In Touch
        </h4>
        <ul class="space-y-4">
          <li>
            <div class="flex items-start gap-3">
              <div
                class="w-8 h-8 bg-neutral-800 rounded-lg flex items-center justify-center flex-shrink-0"
              >
                <svg
                  class="w-4 h-4 text-amber-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <p class="text-neutral-300 text-sm font-medium">
                  St. Louis, Missouri
                </p>
                <p class="text-neutral-400 text-xs mt-0.5">
                  Remote projects worldwide
                </p>
              </div>
            </div>
          </li>
          <li>
            <div class="flex items-start gap-3">
              <div
                class="w-8 h-8 bg-neutral-800 rounded-lg flex items-center justify-center flex-shrink-0"
              >
                <svg
                  class="w-4 h-4 text-amber-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <div>
                <a
                  href="mailto:JakeRMeyers92@gmail.com"
                  class="text-neutral-300 hover:text-amber-400 transition-colors text-sm font-medium break-all"
                >
                  JakeRMeyers92@gmail.com
                </a>
                <p class="text-neutral-400 text-xs mt-0.5">
                  24hr response time
                </p>
              </div>
            </div>
          </li>
          <li>
            <div class="flex items-start gap-3">
              <div
                class="w-8 h-8 bg-neutral-800 rounded-lg flex items-center justify-center flex-shrink-0"
              >
                <svg
                  class="w-4 h-4 text-amber-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <p class="text-neutral-300 text-sm font-medium">
                  Mon - Fri, 9AM - 6PM
                </p>
                <p class="text-neutral-400 text-xs mt-0.5">
                  Central Time (CST)
                </p>
              </div>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-neutral-800 py-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-neutral-400 text-sm">
          © {new Date().getFullYear()} Jake Meyers. All rights reserved.
        </p>
        <div class="flex items-center gap-6 text-xs text-neutral-400">
          <span class="flex items-center gap-1.5">
            <svg
              class="w-4 h-4 text-amber-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
            Built with Astro & Tailwind
          </span>
          <span>•</span>
          <span>Designed & Developed by Jake Meyers</span>
        </div>
      </div>
    </div>
  </div>
</footer>
