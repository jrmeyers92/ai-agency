---
// HomeCTA.astro - Final CTA section for home page
---

<section class="relative py-24 lg:py-32 bg-neutral-50 overflow-hidden">
  <!-- Decorative background -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gradient-to-br from-amber-100/40 via-orange-100/30 to-blue-100/30 rounded-full blur-3xl opacity-60"
  >
  </div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2
      class="text-4xl md:text-5xl lg:text-6xl font-bold text-neutral-900 leading-tight mb-6"
    >
      Ready to bring your
      <span
        class="block mt-2 bg-gradient-to-r from-amber-600 to-orange-600 bg-clip-text text-transparent"
      >
        idea to life?
      </span>
    </h2>

    <p class="text-xl md:text-2xl text-neutral-600 leading-relaxed mb-10 max-w-3xl mx-auto">
      Let's have a conversation about your project. No pressure, no commitment—just
      a friendly chat about what you're building and how I can help.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
      <a
        href="/contact"
        class="group inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-amber-600 to-orange-600 text-white font-semibold rounded-xl hover:shadow-xl hover:shadow-orange-600/20 transition-all duration-300 hover:-translate-y-0.5"
      >
        <span>Get in touch</span>
        <svg
          class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
      <a
        href="/services"
        class="inline-flex items-center justify-center px-8 py-4 bg-white border-2 border-neutral-300 text-neutral-900 font-semibold rounded-xl hover:border-neutral-400 hover:bg-neutral-50 transition-all duration-200"
      >
        View services
      </a>
    </div>

    <!-- Quick contact options -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-6 text-sm text-neutral-600">
      <a
        href="mailto:JakeRMeyers92@gmail.com"
        class="flex items-center gap-2 hover:text-amber-600 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          ></path>
        </svg>
        JakeRMeyers92@gmail.com
      </a>
      <span class="hidden sm:block text-neutral-300">•</span>
      <a
        href="tel:+14174031570"
        class="flex items-center gap-2 hover:text-amber-600 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
          ></path>
        </svg>
        (417) 403-1570
      </a>
    </div>
  </div>
</section>
