---
// FeaturedWork.astro - Condensed portfolio preview for home page
---

<section class="relative py-24 lg:py-32 bg-white overflow-hidden">
  <!-- Decorative background -->
  <div
    class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-gradient-to-br from-purple-100/40 to-pink-100/30 rounded-full blur-3xl opacity-50"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <p
        class="text-sm font-semibold text-amber-700 uppercase tracking-wider mb-3"
      >
        Featured Work
      </p>
      <h2
        class="text-4xl sm:text-5xl font-bold text-neutral-900 leading-tight mb-6"
      >
        Recent projects
      </h2>
      <p class="text-xl text-neutral-600 leading-relaxed">
        A glimpse at what I've built for businesses like yours.
      </p>
    </div>

    <!-- Featured Projects Grid -->
    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <!-- Project 1: Customer Portal -->
      <div
        class="group bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl overflow-hidden shadow-2xl hover:shadow-3xl transition-all duration-300 hover:-translate-y-2"
      >
        <div class="p-8 md:p-10">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-xs font-semibold rounded-full mb-4"
          >
            Full-Stack App
          </div>

          <h3 class="text-2xl md:text-3xl font-bold text-white mb-4">
            Customer Portal Dashboard
          </h3>

          <p class="text-white/90 text-base leading-relaxed mb-6">
            Full-stack customer portal with real-time analytics, account
            management, and integrated billing for 1,000+ daily users.
          </p>

          <!-- Tech stack -->
          <div class="flex flex-wrap gap-2 mb-6">
            <span
              class="px-3 py-1.5 bg-white/20 backdrop-blur-sm text-white text-sm font-medium rounded-lg"
              >React</span
            >
            <span
              class="px-3 py-1.5 bg-white/20 backdrop-blur-sm text-white text-sm font-medium rounded-lg"
              >Node.js</span
            >
            <span
              class="px-3 py-1.5 bg-white/20 backdrop-blur-sm text-white text-sm font-medium rounded-lg"
              >PostgreSQL</span
            >
          </div>

          <a
            href="/work"
            class="inline-flex items-center gap-2 text-white font-semibold hover:gap-3 transition-all"
          >
            View details
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Project 2: AI Chatbot -->
      <div
        class="group bg-gradient-to-br from-purple-500 to-pink-600 rounded-2xl overflow-hidden shadow-2xl hover:shadow-3xl transition-all duration-300 hover:-translate-y-2"
      >
        <div class="p-8 md:p-10">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-xs font-semibold rounded-full mb-4"
          >
            AI Integration
          </div>

          <h3 class="text-2xl md:text-3xl font-bold text-white mb-4">
            AI Customer Support Bot
          </h3>

          <p class="text-white/90 text-base leading-relaxed mb-6">
            AI-powered chatbot that handles 70% of customer inquiries
            automatically with RAG system and seamless human handoff.
          </p>

          <!-- Tech stack -->
          <div class="flex flex-wrap gap-2 mb-6">
            <span
              class="px-3 py-1.5 bg-white/20 backdrop-blur-sm text-white text-sm font-medium rounded-lg"
              >OpenAI</span
            >
            <span
              class="px-3 py-1.5 bg-white/20 backdrop-blur-sm text-white text-sm font-medium rounded-lg"
              >Python</span
            >
            <span
              class="px-3 py-1.5 bg-white/20 backdrop-blur-sm text-white text-sm font-medium rounded-lg"
              >Pinecone</span
            >
          </div>

          <a
            href="/work"
            class="inline-flex items-center gap-2 text-white font-semibold hover:gap-3 transition-all"
          >
            View details
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- CTA to see more -->
    <div class="text-center">
      <a
        href="/work"
        class="inline-flex items-center gap-2 px-8 py-4 bg-neutral-900 text-white font-semibold rounded-xl hover:bg-neutral-800 transition-all duration-300 hover:-translate-y-0.5"
      >
        View all projects
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
