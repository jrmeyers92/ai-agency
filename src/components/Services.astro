---
// Services.astro - Redesigned to emphasize retainers and value
---

<section
  class="relative py-24 lg:py-32 bg-gradient-to-b from-white to-neutral-50"
  id="services"
>
  <!-- Decorative background -->
  <div
    class="absolute top-20 left-0 w-[400px] h-[400px] bg-gradient-to-br from-blue-100/40 to-indigo-100/30 rounded-full blur-3xl opacity-50"
