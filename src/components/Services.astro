---
// Services.astro - Clean, professional services section
---

<section class="py-24 lg:py-32 bg-neutral-50" id="services">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="max-w-3xl mb-20">
      <p class="text-sm font-medium text-neutral-500 uppercase tracking-wider mb-4">Services</p>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-neutral-900 mb-6">
        What I can build for you
      </h2>
      <p class="text-xl text-neutral-600 leading-relaxed">
        From simple landing pages to complex full-stack applications with AI integration. Fixed-price quotes, modern tech stack, and ongoing support.
      </p>
    </div>

    <!-- Web Development Services -->
    <div class="mb-16">
      <h3 class="text-sm font-semibold text-neutral-900 uppercase tracking-wider mb-8">Web Development</h3>
      <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
        <div class="border-l-2 border-neutral-300 pl-6">
          <h4 class="font-semibold text-lg text-neutral-900 mb-2">Business Websites</h4>
          <p class="text-neutral-600 text-sm mb-4">From $1,500</p>
          <ul class="space-y-2 text-sm text-neutral-600">
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Custom design with Tailwind CSS</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Mobile-responsive layouts</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Contact forms & CMS</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>SEO optimization</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Domain & hosting setup</span>
            </li>
          </ul>
        </div>

        <div class="border-l-2 border-neutral-900 pl-6">
          <h4 class="font-semibold text-lg text-neutral-900 mb-2">Full-Stack Applications</h4>
          <p class="text-neutral-600 text-sm mb-4">From $4,000</p>
          <ul class="space-y-2 text-sm text-neutral-600">
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>React/Next.js, Node.js/Java development</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Database design (PostgreSQL, MongoDB)</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>User authentication & security</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Payment processing integration</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Admin dashboards & analytics</span>
            </li>
          </ul>
        </div>

        <div class="border-l-2 border-neutral-300 pl-6">
          <h4 class="font-semibold text-lg text-neutral-900 mb-2">E-Commerce</h4>
          <p class="text-neutral-600 text-sm mb-4">From $3,500</p>
          <ul class="space-y-2 text-sm text-neutral-600">
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Shopify or custom builds</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Product catalog management</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Secure checkout & payments</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Inventory & order management</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Shipping & tax automation</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- AI Services -->
    <div>
      <h3 class="text-sm font-semibold text-neutral-900 uppercase tracking-wider mb-8">AI Integration</h3>
      <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
        <div class="border-l-2 border-neutral-300 pl-6">
          <h4 class="font-semibold text-lg text-neutral-900 mb-2">AI Chatbots</h4>
          <p class="text-neutral-600 text-sm mb-4">From $3,000</p>
          <ul class="space-y-2 text-sm text-neutral-600">
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Customer support automation</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Training on your business data</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>OpenAI, Anthropic, or open-source</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Analytics & insights</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Handoff to human agents</span>
            </li>
          </ul>
        </div>

        <div class="border-l-2 border-neutral-300 pl-6">
          <h4 class="font-semibold text-lg text-neutral-900 mb-2">RAG & Search</h4>
          <p class="text-neutral-600 text-sm mb-4">From $5,000</p>
          <ul class="space-y-2 text-sm text-neutral-600">
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Semantic search for docs</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Question-answering systems</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Document processing pipelines</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Vector database integration</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Custom AI workflows</span>
            </li>
          </ul>
        </div>

        <div class="border-l-2 border-neutral-300 pl-6">
          <h4 class="font-semibold text-lg text-neutral-900 mb-2">Custom AI Tools</h4>
          <p class="text-neutral-600 text-sm mb-4">From $2,500</p>
          <ul class="space-y-2 text-sm text-neutral-600">
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Content generation tools</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Data analysis automation</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>Image/document processing</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>API integrations</span>
            </li>
            <li class="flex items-start">
              <span class="text-neutral-400 mr-2">—</span>
              <span>MCP servers</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
